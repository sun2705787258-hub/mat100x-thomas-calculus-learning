{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.thomas-study/quality/batch-qa.schema.json",
  "title": "Thomas batch quality record v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "batch",
    "chapters",
    "status",
    "textbook",
    "sourcePdfSha256",
    "metrics",
    "checks",
    "defects",
    "pdfSha256",
    "nextBatch"
  ],
  "properties": {
    "schemaVersion": {
      "const": "thomas-batch-qa-v2"
    },
    "batch": {
      "type": "string",
      "pattern": "^B[1-9]$"
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 17
      }
    },
    "status": {
      "enum": ["passed", "needs-rework"]
    },
    "textbook": {
      "const": "Thomas' Calculus, Fourteenth Edition in SI Units"
    },
    "sourcePdfSha256": {
      "const": "03597823863F899FD71847F306551DA6CF70D3D327578B62C7FFAB4C136CEB39"
    },
    "metrics": {
      "type": "object",
      "required": [
        "newTerms",
        "newExercises",
        "renderedFormulas",
        "numericChecksPassed",
        "pdfPages",
        "desktopWidth",
        "desktopScrollWidth",
        "mobileWidth",
        "mobileScrollWidth",
        "katexErrors",
        "browserErrors",
        "desktopFormulaClipped",
        "mobileFormulaClipped",
        "mobileFormulaScrollable",
        "printFormulaClipped",
        "printFormulaOverflow",
        "crossBatchPagesPassed",
        "crossBatchPagesTotal"
      ],
      "properties": {
        "newTerms": {
          "type": "integer",
          "minimum": 0
        },
        "newExercises": {
          "type": "integer",
          "minimum": 0
        },
        "renderedFormulas": {
          "type": "integer",
          "minimum": 0
        },
        "numericChecksPassed": {
          "type": "integer",
          "minimum": 0
        },
        "pdfPages": {
          "type": "integer",
          "minimum": 1
        },
        "desktopWidth": {
          "const": 1440
        },
        "desktopScrollWidth": {
          "type": "integer",
          "maximum": 1441
        },
        "mobileWidth": {
          "const": 390
        },
        "mobileScrollWidth": {
          "type": "integer",
          "maximum": 391
        },
        "katexErrors": {
          "const": 0
        },
        "browserErrors": {
          "const": 0
        },
        "desktopFormulaClipped": {
          "const": 0
        },
        "mobileFormulaClipped": {
          "const": 0
        },
        "mobileFormulaScrollable": {
          "type": "integer",
          "minimum": 0
        },
        "printFormulaClipped": {
          "const": 0
        },
        "printFormulaOverflow": {
          "const": 0
        },
        "crossBatchPagesPassed": {
          "type": "integer",
          "minimum": 1
        },
        "crossBatchPagesTotal": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "object",
      "required": [
        "G1_source",
        "G2_coverage",
        "G3_terms",
        "G4_theorems_formulas",
        "G5_examples",
        "G6_exercises_answers",
        "G7_math_rendering",
        "G8_diagrams_links",
        "G9_web_print",
        "G10_copyright_version"
      ],
      "additionalProperties": true
    },
    "defects": {
      "type": "object",
      "required": ["P0", "P1", "P2Open", "closed"],
      "properties": {
        "P0": {
          "const": 0
        },
        "P1": {
          "const": 0
        },
        "P2Open": {
          "const": 0
        },
        "closed": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "pdfSha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "nextBatch": {
      "type": "object",
      "required": ["id", "chapters"],
      "properties": {
        "id": {
          "type": "string"
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
